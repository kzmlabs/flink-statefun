<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>statefun-parent</artifactId>
        <groupId>io.github.kzmlabs.flinkstatefun</groupId>
        <version>3.4.0-KZM-3.0-RC1</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>statefun-k8s-native-e2e</artifactId>
    <name>statefun-k8s-native-e2e</name>

    <properties>
        <central.skip>true</central.skip>
        <skipTests>false</skipTests>
        <kafka-clients.version>3.9.0</kafka-clients.version>
        <awssdk.version>2.29.29</awssdk.version>
        <awaitility.version>4.2.2</awaitility.version>
        <assertj.version>3.27.3</assertj.version>
        
        <slf4j.version>2.0.9</slf4j.version>
        <!-- CI can set this true to keep the cluster alive for log collection -->
        <skip.teardown>false</skip.teardown>
    </properties>

    <dependencies>
        <!-- Reactor ordering: ensures statefun-docker is built (and target/docker
             populated) before this module enters pre-integration-test. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>statefun-docker</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>

        <!-- Protobuf for shared message types (compile scope needed because
             protoc-jar-maven-plugin generates sources in generate-sources phase) -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>

        <!-- Kafka client (drives Kafka E2E) -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka-clients.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- AWS SDK v2 clients (drive Kinesis streams + S3 checkpoint bucket via LocalStack) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>kinesis</artifactId>
            <version>${awssdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${awssdk.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Awaitility -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>${awaitility.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            
            <scope>test</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generate protobuf test classes from src/test/protobuf -->
            <plugin>
                <groupId>com.github.os72</groupId>
                <artifactId>protoc-jar-maven-plugin</artifactId>
            </plugin>

            <!-- Skip deploy — test module only -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>

            <!-- Skip dependency convergence — test deps have complex transitive trees -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Runs automatically; skip with -Dskip.k8s.e2e or -DskipTests -->
            <id>k8s-e2e</id>
            <activation>
                <property>
                    <name>!skip.k8s.e2e</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <configuration>
                            <skip>${skipTests}</skip>
                        </configuration>
                        <executions>
                            <!-- 1. Build flink-statefun:e2e Docker image
                                 (context staged by statefun-docker/prepare-package). -->
                            <execution>
                                <id>build-statefun-image</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.basedir}/../statefun-docker/target/docker</workingDirectory>
                                    <arguments>
                                        <argument>build</argument>
                                        <argument>-t</argument>
                                        <argument>flink-statefun:e2e</argument>
                                        <argument>.</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- 2. Build remote function uber JAR -->
                            <execution>
                                <id>build-remote-function</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>mvn</executable>
                                    <arguments>
                                        <argument>package</argument>
                                        <argument>-f</argument>
                                        <argument>${project.basedir}/remote-function/pom.xml</argument>
                                        <argument>-DskipTests</argument>
                                        <argument>-B</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- 3. Build remote function Docker image -->
                            <execution>
                                <id>build-remote-function-image</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.basedir}/remote-function</workingDirectory>
                                    <arguments>
                                        <argument>build</argument>
                                        <argument>-t</argument>
                                        <argument>statefun-remote-function:e2e</argument>
                                        <argument>.</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- 4. Setup kind cluster + deploy infra -->
                            <execution>
                                <id>setup-cluster</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/setup-cluster.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!--
                                5. Teardown kind cluster. Skippable via -Dskip.teardown=true
                                so CI can run its own log-collection step against the live
                                cluster before tearing down via the workflow's always() step.
                            -->
                            <execution>
                                <id>teardown-cluster</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${skip.teardown}</skip>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/teardown-cluster.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Failsafe for E2E tests -->
                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${maven-failsafe-plugin.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includes>
                                <include>**/*E2E.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
